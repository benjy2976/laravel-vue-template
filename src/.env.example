APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080   # la app entra por Nginx (puerto 8080)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos (servicio "db")
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=laravel

# Sesiones / Cache (elige una de estas 2 opciones)
# Opción A: usar Redis (recomendada en docker)
SESSION_DRIVER=redis
CACHE_STORE=redis

# Opción B (si prefieres DB para sesiones):
# SESSION_DRIVER=database
# CACHE_STORE=database
# (si usas database para sesiones: php artisan session:table && php artisan migrate)

# Redis (servicio "redis")
# Si instalaste la extensión phpredis en PHP:
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# (Alternativa si NO instalaste la extensión y usas Predis):
# REDIS_CLIENT=predis
# REDIS_HOST=redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database   # simple para dev

MEMCACHED_HOST=127.0.0.1    # no se usa; puedes ignorarlo

# Mailpit (servicio "mailpit")
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# HMR de Vite (el navegador hablará a localhost:5173)
VITE_HOST=localhost
VITE_PORT=5173
